<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — WhatsApp-style for Offline Messenger -->
    <style name="Theme.MeshConnect" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color (WhatsApp green) -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Secondary / Teal accent -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Status bar — dark WhatsApp teal header -->
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background — WhatsApp wallpaper tan -->
        <item name="android:colorBackground">@color/background</item>
    </style>
</resources>
